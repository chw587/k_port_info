function addSwitchToggleEvent(obj, callback) {
    $(obj).on('click', function(e) {
        var targetId = $(this).attr('data-target');
        if(targetId == "movi-toggle") {
            if($(this).hasClass('off')) {
                $(this).parents('#sub-contents').find('.move-wrap').removeClass('off').find('.move-control-area').removeAttr('aria-hidden');
                $(this).removeClass('off').html('<span class="hide">On</span>');
                $(this).parents('#sub-contents').find('.move-control-area').find('select').attr('tabindex','0');
                $(this).parents('#sub-contents').find('.move-control-area').find('button').attr('tabindex','0');
                $(this).parents('#sub-contents').find('.move-control-area').find('input').attr('tabindex','0');
                $(this).parents('#sub-contents').find('.move-control-area').find('a').attr('tabindex','0');
            } else {
                $(this).parents('#sub-contents').find('.move-wrap').addClass('off').find('.move-control-area').attr('aria-hidden', true);
                $(this).addClass('off').html('<span class="hide">Off</span>');
                $(this).parents('#sub-contents').find('.move-control-area').find('select').attr('tabindex','-1');
                $(this).parents('#sub-contents').find('.move-control-area').find('button').attr('tabindex','-1');
                $(this).parents('#sub-contents').find('.move-control-area').find('input').attr('tabindex','-1');
                $(this).parents('#sub-contents').find('.move-control-area').find('a').attr('tabindex','-1');
            }
        } else {
            if($(this).hasClass('off')) {
                $('#' + targetId).removeClass('group-toggle-off').removeAttr('aria-hidden');
                $(this).removeClass('off').html('<span class="hide">On</span>');
                $('#' + targetId).find('select').attr('tabindex','0');
                $('#' + targetId).find('button').attr('tabindex','0');
                $('#' + targetId).find('input').attr('tabindex','0');
                $('#' + targetId).find('a').attr('tabindex','0');
            } else {
                $('#' + targetId).addClass('group-toggle-off').attr('aria-hidden', true);
                $(this).addClass('off').html('<span class="hide">Off</span>');
                $('#' + targetId).find('select').attr('tabindex','-1');
                $('#' + targetId).find('button').attr('tabindex','-1');
                $('#' + targetId).find('input').attr('tabindex','-1');
                $('#' + targetId).find('a').attr('tabindex','-1');
            }
        }

        if(typeof callback === "function")  callback();
    });

    var targetId = $(obj).attr('data-target');
    if(targetId == "movi-toggle") {
        if($(obj).hasClass('off')) {
            $(obj).parents('#sub-contents').find('.move-control-area').find('select').attr('tabindex','-1');
            $(obj).parents('#sub-contents').find('.move-control-area').find('button').attr('tabindex','-1');
            $(obj).parents('#sub-contents').find('.move-control-area').find('input').attr('tabindex','-1');
            $(obj).parents('#sub-contents').find('.move-control-area').find('a').attr('tabindex','-1');
        } else {
            $(obj).parents('#sub-contents').find('.move-control-area').find('select').attr('tabindex','0');
            $(obj).parents('#sub-contents').find('.move-control-area').find('button').attr('tabindex','0');
            $(obj).parents('#sub-contents').find('.move-control-area').find('input').attr('tabindex','0');
            $(obj).parents('#sub-contents').find('.move-control-area').find('a').attr('tabindex','0');
        }
    } else {
        if($(obj).hasClass('off')) {
            $('#' + targetId).find('select').attr('tabindex','-1');
            $('#' + targetId).find('button').attr('tabindex','-1');
            $('#' + targetId).find('input').attr('tabindex','-1');
            $('#' + targetId).find('a').attr('tabindex','-1');
        } else {
            $('#' + targetId).find('select').attr('tabindex','0');
            $('#' + targetId).find('button').attr('tabindex','0');
            $('#' + targetId).find('input').attr('tabindex','0');
            $('#' + targetId).find('a').attr('tabindex','0');
        }
    }
   
}